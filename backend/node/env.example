NODE_PORT=4000
HOST=0.0.0.0
FRONTEND_ORIGIN=http://localhost:5173
JWT_SECRET=graphcore-dev-secret-change-me
JWT_EXPIRES=7d

# Meta (control-plane) + default tenant (data-plane) Postgres
# When DATABASE_URL is set in production, meta must be reachable (no silent in-memory).
DATABASE_URL=postgresql://graphcore:graphcore@localhost:5432/graphcore_meta
TENANT_DATABASE_URL=postgresql://graphcore:graphcore@localhost:5432/graphcore_demo
REQUIRE_META_DB=0

# Shared-server provisioning (CREATE DATABASE / ROLE on same Postgres)
PROVISION_ADMIN_URL=postgresql://graphcore:graphcore@localhost:5432/graphcore_meta
PROVISION_DB_HOST=localhost
PROVISION_PUBLIC_HOST=localhost
PROVISION_PUBLIC_PORT=5432
PROVISION_REGION=shared

# Public API base for restUrl in responses (production domain)
PUBLIC_API_URL=http://localhost:4000

# Stripe (Checkout + PaymentIntent + webhook)
# Production: STRIPE_WEBHOOK_SECRET is REQUIRED (unsigned webhook rejected).
# Dev: if unset, webhook accepts unsigned JSON (mode=dev-no-secret).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_PRO=
STRIPE_PRICE_SCALE=

# iyzico (TR) — sandbox env ready; SDK wire still STUB
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# PayTR (TR) — env ready; get-token wire still STUB
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=

# Optional
OPENAI_API_KEY=
POSTGREST_URL=http://localhost:3001
