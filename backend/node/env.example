NODE_PORT=4000
HOST=0.0.0.0
FRONTEND_ORIGIN=http://localhost:5173
JWT_SECRET=graphcore-dev-secret-change-me
JWT_EXPIRES=7d

# Meta (control-plane) + default tenant (data-plane) Postgres
# When DATABASE_URL is set in production, meta must be reachable (no silent in-memory).
DATABASE_URL=postgresql://graphcore:graphcore@localhost:5432/graphcore_meta
TENANT_DATABASE_URL=postgresql://graphcore:graphcore@localhost:5432/graphcore_demo
REQUIRE_META_DB=0

# Shared-server provisioning (CREATE DATABASE / ROLE on same Postgres)
PROVISION_ADMIN_URL=postgresql://graphcore:graphcore@localhost:5432/graphcore_meta
PROVISION_DB_HOST=localhost
PROVISION_PUBLIC_HOST=localhost
PROVISION_PUBLIC_PORT=5432
PROVISION_REGION=shared

# Public API base for restUrl + payment callbacks
PUBLIC_API_URL=http://localhost:4000

# Stripe (Checkout + PaymentIntent + webhook)
# Production: STRIPE_WEBHOOK_SECRET is REQUIRED (unsigned webhook rejected).
# Dev: if unset, webhook accepts unsigned JSON (mode=dev-no-secret).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_PRO=
STRIPE_PRICE_SCALE=
STRIPE_PRICE_MAX=
STRIPE_PRICE_BACKUP=

# iyzico (TR) — sandbox: https://sandbox-api.iyzipay.com
# Set keys to call Checkout Form Initialize (iyzipay SDK). Callback:
#   POST /api/billing/webhook/iyzico
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# PayTR (TR) — get-token iframe; notification:
#   POST /api/billing/webhook/paytr  (must return body "OK")
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
PAYTR_TEST_MODE=1

# Storage — MinIO / S3-compatible (docker compose service: minio)
# If S3_* unset, API falls back to local disk under STORAGE_LOCAL_PATH.
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=1
STORAGE_LOCAL_PATH=
STORAGE_MAX_BYTES=26214400
STORAGE_SIGNING_SECRET=

# Edge Functions (Node VM worker MVP)
FUNCTIONS_ROOT=
FUNCTIONS_TIMEOUT_MS=3000

# Project Auth
PROJECT_JWT_EXPIRES=1h
PROJECT_REFRESH_DAYS=30

# Cloud Infrastructure (provider-agnostic; default driver token)
HETZNER_API_TOKEN=
CLOUD_SECRETS_KEY=
CLOUD_HTTP_TIMEOUT_MS=30000

# Optional
OPENAI_API_KEY=
POSTGREST_URL=http://localhost:3001
DEBUG_REALTIME=0
