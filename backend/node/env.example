NODE_PORT=4000
HOST=0.0.0.0
FRONTEND_ORIGIN=http://localhost:5173
JWT_SECRET=graphcore-dev-secret-change-me
JWT_EXPIRES=7d

# Meta (control-plane) + default tenant (data-plane) Postgres
# When DATABASE_URL is set in production, meta must be reachable (no silent in-memory).
DATABASE_URL=postgresql://graphcore:graphcore@localhost:5432/graphcore_meta
TENANT_DATABASE_URL=postgresql://graphcore:graphcore@localhost:5432/graphcore_demo
REQUIRE_META_DB=0

# Shared-server provisioning (CREATE DATABASE / ROLE on same Postgres)
PROVISION_ADMIN_URL=postgresql://graphcore:graphcore@localhost:5432/graphcore_meta
PROVISION_DB_HOST=localhost
PROVISION_PUBLIC_HOST=localhost
PROVISION_PUBLIC_PORT=5432
PROVISION_REGION=shared

# Public API base for restUrl + payment callbacks
PUBLIC_API_URL=http://localhost:4000

# Card checkout — Polar MoR (primary). Lemon Squeezy: legacy stores only.
# PAYMENTS_DISABLED: comma-separated provider ids disabled at checkout (default below).
PAYMENTS_DISABLED=stripe,iyzico,paytr,lemonsqueezy
#
# Polar — required for live card checkout:
#   POLAR_ACCESS_TOKEN (OAT, polar_oat_...) after org claim in Polar dashboard — preferred
#   OR POLAR_AGENT_IDENTITY_ASSERTION (JWT) — API mints short-lived token automatically
#   POLAR_ORGANIZATION_ID, POLAR_PRODUCT_ID_ONCE | _MONTH | _YEAR, POLAR_WEBHOOK_SECRET
# Webhook URL (PUBLIC_API_URL + path): POST /api/billing/webhook/polar
POLAR_ACCESS_TOKEN=
POLAR_AGENT_IDENTITY_ASSERTION=
POLAR_ORGANIZATION_ID=
POLAR_PRODUCT_ID_ONCE=
POLAR_PRODUCT_ID_MONTH=
POLAR_PRODUCT_ID_YEAR=
POLAR_WEBHOOK_SECRET=

# Lemon Squeezy (legacy / existing stores only — new signup closed)
# LEMON_SQUEEZY_API_KEY=
# LEMON_SQUEEZY_STORE_ID=
# LEMON_SQUEEZY_VARIANT_ID=
# LEMON_SQUEEZY_VARIANT_ID_SUB=
# LEMON_SQUEEZY_WEBHOOK_SECRET=
# Webhook: POST /api/billing/webhook/lemonsqueezy

# Stripe (pasif — PAYMENTS_DISABLED) Checkout + PaymentIntent + webhook
# Production: STRIPE_WEBHOOK_SECRET is REQUIRED (unsigned webhook rejected).
# Dev: if unset, webhook accepts unsigned JSON (mode=dev-no-secret).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_PRO=
STRIPE_PRICE_SCALE=
STRIPE_PRICE_MAX=
STRIPE_PRICE_BACKUP=
STRIPE_PRICE_PRO_YEAR=
STRIPE_PRICE_SCALE_YEAR=
STRIPE_PRICE_MAX_YEAR=
STRIPE_PRICE_BACKUP_YEAR=
STRIPE_PRICE_VPS=
STRIPE_PRICE_VPS_YEAR=

# iyzico (TR) — pasif (PAYMENTS_DISABLED). Sandbox: https://sandbox-api.iyzipay.com
#   POST /api/billing/webhook/iyzico
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# PayTR (TR) — pasif (PAYMENTS_DISABLED). get-token iframe; notification:
#   POST /api/billing/webhook/paytr  (must return body "OK")
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
PAYTR_TEST_MODE=1

# Crypto (NOWPayments) — invoice checkout + IPN
# Without API key: demo /billing/crypto page + POST /api/billing/crypto/confirm
# IPN: POST /api/billing/webhook/crypto
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_PAY_CURRENCY=usdttrc20
NOWPAYMENTS_API_URL=https://api.nowpayments.io/v1
# CRYPTO_ALLOW_MANUAL_CONFIRM=1  # live key varken manuel onay (yalnızca test)

# Storage — S3-compatible object store (MinIO local / prod S3).
# Veeam Backup & QNAP Hybrid Backup Sync connect via this endpoint.
# If S3_* unset → local disk STORAGE_LOCAL_PATH.
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=eu-central-1
S3_FORCE_PATH_STYLE=1
STORAGE_LOCAL_PATH=
STORAGE_MAX_BYTES=26214400
STORAGE_SIGNING_SECRET=

# Edge Functions (Node VM worker MVP)
FUNCTIONS_ROOT=
FUNCTIONS_TIMEOUT_MS=3000

# Project Auth
PROJECT_JWT_EXPIRES=1h
PROJECT_REFRESH_DAYS=30

# Cloud Infrastructure (provider-agnostic; default driver token)
HETZNER_API_TOKEN=
CLOUD_SECRETS_KEY=
CLOUD_HTTP_TIMEOUT_MS=30000

# WireGuard VPN add-on (optional real endpoint; mock works without these)
# Example: WIREGUARD_ENDPOINT=vpn.example.com:51820
WIREGUARD_ENDPOINT=
WIREGUARD_SERVER_PUBLIC_KEY=
WIREGUARD_SUBNET=10.66.0.0/24
WIREGUARD_DNS=1.1.1.1
# Set to 1 to prefer `wg genkey` when wireguard-tools is installed
WIREGUARD_USE_WG=0
STRIPE_PRICE_VPN=
STRIPE_PRICE_VPN_YEAR=

# Optional
OPENAI_API_KEY=
POSTGREST_URL=http://localhost:3001
DEBUG_REALTIME=0

# Platform supervisor (comma-separated; promoted on API boot)
# Platform supervisor (Console /supervisor) — virgülle birden fazla e-posta
SUPERVISOR_EMAIL=info@dbstorages.com
# İlk kurulumda yoksa oluşturmak için (min 8 karakter); mevcut kullanıcıda şifreyi değiştirmez
SUPERVISOR_PASSWORD=
SUPERVISOR_NAME=Supervisor

# Mock checkout smoke (keys empty → mock URL + local provision)
# WEB /database → sepet → Checkout → /billing/success → Console /dashboard
# Supervisor: SUPERVISOR_EMAIL user → Console /supervisor (users/tenants/payments/servers)
# Webhooks: POST /api/billing/webhook/stripe|iyzico|paytr (PayTR body must be OK)

# Domain catalog (mock registrar — gerçek API sonraki tur)
DOMAIN_MARKUP=1
# DOMAIN_DNS_CHECK=0
# DOMAIN_REGISTRAR_API_KEY=
# DOMAIN_REGISTRAR_ENABLED=1  # unset: paid domains stay pending_fulfillment (manual)
