# GraphCore — kök ortam örneği
# Node detayları: backend/node/env.example
# Prod: docker-compose.prod.yml + Dokploy env (README)

VITE_NODE_API_BASE=/api
VITE_GO_API_BASE=/api/v1

# Yerel Postgres (docker compose)
# DATABASE_URL=postgresql://graphcore:graphcore@localhost:5432/graphcore_meta
# TENANT_DATABASE_URL=postgresql://graphcore:graphcore@localhost:5432/graphcore_demo
# POSTGREST_URL=http://localhost:3001

# MinIO (docker compose — Storage MVP)
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_REGION=us-east-1
# S3_FORCE_PATH_STYLE=1
# MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=minioadmin

# Dokploy / prod (örnek — secret'ları compose/Dokploy UI'dan verin)
# FRONTEND_ORIGIN=https://your-domain.com
# PUBLIC_API_URL=https://your-domain.com
# JWT_SECRET=change-me
# POSTGRES_PASSWORD=change-me
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# IYZICO_API_KEY=
# IYZICO_SECRET_KEY=
# PAYTR_MERCHANT_ID=
# PAYTR_MERCHANT_KEY=
# PAYTR_MERCHANT_SALT=
# PROVISION_PUBLIC_HOST=your-domain.com
