# GraphCore — kök ortam örneği
# Node detayları: backend/node/env.example
# Prod: docker-compose.prod.yml + Dokploy env (README)

VITE_NODE_API_BASE=/api
VITE_GO_API_BASE=/api/v1

# Dual frontend (dev)
VITE_WEB_URL=http://localhost:5173
VITE_CONSOLE_URL=http://localhost:5174

# Yerel Postgres (docker compose)
# DATABASE_URL=postgresql://graphcore:graphcore@localhost:5432/graphcore_meta
# TENANT_DATABASE_URL=postgresql://graphcore:graphcore@localhost:5432/graphcore_demo
# POSTGREST_URL=http://localhost:3001

# MinIO (docker compose — Storage MVP)
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_REGION=us-east-1
# S3_FORCE_PATH_STYLE=1
# MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=minioadmin

# Dokploy / prod (örnek — secret'ları compose/Dokploy UI'dan verin)
# FRONTEND_ORIGIN=https://dbstorages.com,https://www.dbstorages.com,https://api.dbstorages.com
# VITE_WEB_URL=https://dbstorages.com
# VITE_CONSOLE_URL=https://dbstorages.com/app
# API subdomain (RetailEX api.* kalıbı) — aynı stack, yapı değişmez; restUrl bu hosttan üretilir
# PUBLIC_API_URL=https://api.dbstorages.com
# PROVISION_PUBLIC_HOST=dbstorages.com
# JWT_SECRET=change-me
# POSTGRES_PASSWORD=change-me
# Polar MoR (primary card) — detail: backend/node/env.example
# PAYMENTS_DISABLED=stripe,iyzico,paytr,lemonsqueezy  (default when unset)
# POLAR_ACCESS_TOKEN=polar_oat_...  # OAT after Polar org claim; or POLAR_AGENT_IDENTITY_ASSERTION
# POLAR_ORGANIZATION_ID=
# POLAR_PRODUCT_ID_ONCE= | POLAR_PRODUCT_ID_MONTH= | POLAR_PRODUCT_ID_YEAR=
# POLAR_WEBHOOK_SECRET=  # POST /api/billing/webhook/polar
# STRIPE_SECRET_KEY=   # pasif
# STRIPE_WEBHOOK_SECRET=
# IYZICO_API_KEY=     # pasif
# IYZICO_SECRET_KEY=
# PAYTR_MERCHANT_ID=  # pasif
# PAYTR_MERCHANT_KEY=
# PAYTR_MERCHANT_SALT=

# Crypto (NOWPayments) — empty key = demo /billing/crypto
# NOWPAYMENTS_API_KEY=
# NOWPAYMENTS_IPN_SECRET=
# NOWPAYMENTS_PAY_CURRENCY=usdttrc20
# PROVISION_PUBLIC_HOST=your-domain.com

# Cloud Infrastructure
# HETZNER_API_TOKEN=
# CLOUD_SECRETS_KEY=

# Payments (detay: backend/node/env.example)
# STRIPE_PRICE_PRO=
# STRIPE_PRICE_PRO_YEAR=
# STRIPE_PRICE_SCALE=
# STRIPE_PRICE_SCALE_YEAR=
# STRIPE_PRICE_MAX=
# STRIPE_PRICE_MAX_YEAR=
# STRIPE_PRICE_BACKUP=
# STRIPE_PRICE_BACKUP_YEAR=
# STRIPE_PRICE_VPS=
# STRIPE_PRICE_VPS_YEAR=
# STRIPE_PRICE_VPN=
# STRIPE_PRICE_VPN_YEAR=
# SUPERVISOR_EMAIL=info@dbstorages.com
# SUPERVISOR_PASSWORD=

# Mock smoke: Polar/crypto keys empty → mock checkout; stripe/iyzico/paytr disabled by default
